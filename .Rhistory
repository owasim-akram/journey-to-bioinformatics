dir.create("02-bulk-rna-seq")
dir.create("03-single-cell-rna-seq")
dir.create("04-spatial-transcriptomics")
dir.create("05-ai-for-bioinformatics")
modules <- c(
"01-computational-foundations",
"02-bulk-rna-seq",
"03-single-cell-rna-seq",
"04-spatial-transcriptomics",
"05-ai-for-bioinformatics"
)
for (folder in modules) {
file.create(file.path(folder, "README.md"))
}
for (folder in modules) {
cat(
folder, "->",
file.exists(file.path(folder, "README.md")),
"\n"
)
}
# Five learning modules
modules <- c(
"01-computational-foundations",
"02-bulk-rna-seq",
"03-single-cell-rna-seq",
"04-spatial-transcriptomics",
"05-ai-for-bioinformatics"
)
# Create simple README files for the modules
for (folder in modules) {
dir.create(folder, showWarnings = FALSE)
writeLines(
paste0("# ", folder, "\n\nMy bioinformatics learning notes and practice."),
file.path(folder, "README.md")
)
}
# Create the three main folders
main_folders <- c(
"projects",
"bioinformatics-tools",
"resources"
)
# Create each folder and its simple README
for (folder in main_folders) {
dir.create(folder, showWarnings = FALSE)
writeLines(
paste0("# ", folder, "\n\nResources and materials collected during my bioinformatics journey."),
file.path(folder, "README.md")
)
}
cat("All folders and README files are ready!\n")
all_folders <- c(
"01-computational-foundations",
"02-bulk-rna-seq",
"03-single-cell-rna-seq",
"04-spatial-transcriptomics",
"05-ai-for-bioinformatics",
"projects",
"bioinformatics-tools",
"resources"
)
for (folder in all_folders) {
cat(
folder, ":",
file.exists(file.path(folder, "README.md")),
"\n"
)
}
system("git status")
system("git diff -- .gitignore")
module <- "01-computational-foundations"
for (day in sprintf("day-%02d", 1:4)) {
dir.create(file.path(module, day), showWarnings = FALSE)
}
module <- "01-computational-foundations"
days <- sprintf("day-%02d", 1:4)
for (day in days) {
day_path <- file.path(module, day)
readme_path <- file.path(day_path, "README.md")
if (!file.exists(readme_path)) {
writeLines(
c(
paste("#", toupper(gsub("-", " ", day))),
"",
"## Topics Covered",
"- To be added",
"",
"## Practice",
"- To be added",
"",
"## Key Learnings",
"- To be added"
),
readme_path
)
}
}
cat("Day README files created!\n")
